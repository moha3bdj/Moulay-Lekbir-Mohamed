# .env.example - Portfolio Environment Configuration Template
# NOTE: Never commit sensitive credentials or secret keys to version control.
# Any client-facing variables in Vite must be prefixed with VITE_.

# App Environment
VITE_APP_ENV=production
VITE_SITE_URL=https://moulay.vercel.app

# Optional: Dedicated Contact Endpoint Override (leave empty to use default /api/contact)
VITE_CONTACT_API_ENDPOINT=
